long long maxAlternatingSum(vector<int>& nums) {
        long long ans=0;
        vector<long long>temp;
        for(int i=0;i<nums.size();i++){
            temp.push_back(nums[i]*nums[i]);
        }
        sort(temp.begin(),temp.end());
        int k=nums.size()/2;
        for(int i=0;i<k;i++){
            ans-=temp[i];
        }
        for(int i=k;i<nums.size();i++){
            ans+=temp[i];
        }
        return ans;
    }
