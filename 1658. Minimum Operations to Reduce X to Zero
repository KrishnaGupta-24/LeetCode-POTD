int minOperations(vector<int>& nums, int x) {
        int n=nums.size();
        long long total=0;
        for(int num:nums){
            total+=num;
        }
        long long tar=total-x;
        if(tar==0){
            return n;
        }
        int i=0;
        long long sum=0;
        int maxLen=-1;
        for(int j=0;j<n;j++){
            sum+=nums[j];
            while(i<=j && sum>tar){
                sum-=nums[i];
                i++;
            }
            if(sum==tar){
                maxLen=max(maxLen,j-i+1);
            }
        }
        if(maxLen==-1){
            return -1;
        }
        return n-maxLen;
    }
