int minimumDeletions(vector<int>& nums) {
        int n=nums.size();
        if(n<=2){
            return n;
        }
        int max_idx=0,min_idx=0;
        int maxi=INT_MIN,mini=INT_MAX;
        for(int i=0;i<n;i++){
            if(nums[i]<mini){
                mini=nums[i];
                min_idx=i;
            }
            if(nums[i]>maxi){
                maxi=nums[i];
                max_idx=i;
            }
        }
        if(min_idx>max_idx){
            swap(min_idx,max_idx);
        }
        int left=max_idx+1;
        int right=n-min_idx;
        int middle=(min_idx+1)+(n-max_idx);
        return min({left,right,middle});

    }
