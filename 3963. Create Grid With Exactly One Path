vector<string> createGrid(int m, int n) {
        vector<vector<char>> temp(m,vector<char>(n,'#'));
        for(int i=0;i<m;i++){
            temp[i][0]='.';
        }
        for(int i=0;i<n;i++){
            temp[m-1][i]='.';
        }
        vector<string> ans;
        for(int i=0;i<m;i++){
            string a="";
            for(int j=0;j<n;j++){
                a+=temp[i][j];
            }
            ans.push_back(a);
        }

        return ans;
    }
