int func1(int i,int j,vector<int>&nums){
        int temp=INT_MIN;
        for(int k=i;k<=j;k++){
            if(nums[k]>temp){
                temp=nums[k];
            }
        }
        return temp;
    }
    int func2(int i,int j,vector<int>&nums){
        int temp=INT_MAX;
        for(int k=i;k<=j;k++){
            if(nums[k]<temp){
                temp=nums[k];
            }
        }
        return temp;
    }
    int firstStableIndex(vector<int>& nums, int k) {
        int n=nums.size();
        if(n==1){
            return (nums[0]==k)?0:0;
        }
        for(int i=0;i<n;i++){
            if(func1(0,i,nums)-func2(i,n-1,nums)<=k){
                return i;
            }
        }
        return -1;
    }
