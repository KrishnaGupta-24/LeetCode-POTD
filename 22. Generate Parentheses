vector<string> generateParenthesis(int n) {
        if(n--==1)return {"()"};
        vector<string>res;
        auto dfs=[&](auto&self,int o ,int c,string s)->void{
            if(o==0 && c==0){
                res.push_back(s+")");
                return ;
            }
            if(o>0){
                self(self,o-1,c,s+"(");
            }
            if(c>=o){
                self(self,o,c-1,s+")");
            }
        };
        dfs(dfs,n,n,"(");
        return res;
    }
